[Unit]
Description=FrameForge Private Storyboard System
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/mnt/Media2/Apps/storyboard/app
EnvironmentFile=/mnt/Media2/Apps/storyboard/config/storyboard.env
ExecStart=/usr/bin/python3 /mnt/Media2/Apps/storyboard/app/server.py
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/mnt/Media2/Apps/storyboard/data
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictNamespaces=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
