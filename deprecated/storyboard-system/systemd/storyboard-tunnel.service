[Unit]
Description=FrameForge outbound reverse tunnel to public entry
After=network-online.target storyboard.service
Wants=network-online.target
Requires=storyboard.service

[Service]
Type=simple
User=root
ExecStart=/usr/bin/ssh -NT -o ExitOnForwardFailure=yes -o ServerAliveInterval=30 -o ServerAliveCountMax=3 -o StrictHostKeyChecking=yes -o UserKnownHostsFile=/mnt/Media2/Apps/storyboard/tunnel/known_hosts -i /mnt/Media2/Apps/storyboard/tunnel/id_ed25519 -R 127.0.0.1:18766:192.168.100.100:18765 storyboard-tunnel@23.226.133.16
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/mnt/Media2/Apps/storyboard/tunnel

[Install]
WantedBy=multi-user.target
