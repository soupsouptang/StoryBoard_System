+                if table == "projects":
+                    row.update(share_token=None, deleted_at=None, updated_by_user_id=None)
+                if table == "comments":
+                    row["author_user_id"] = None
+                insert_record(db, table, row)
+        touch_project(db, pid, session)
+        db.commit()
+        return pid
+    except Exception:
+        db.rollback()
+        for path in created_files:
+            path.unlink(missing_ok=True)
+        raise
