+.shot-inspector { height:100%; max-height:100%; overflow-y:scroll; overflow-x:hidden; }
+.review-before-version-strip { display:flex; gap:6px; min-width:0; max-width:100%; margin:0 0 9px; padding:2px 0 7px; overflow-x:auto; overflow-y:hidden; scrollbar-gutter:stable; }
+.review-before-version-wrap { display:flex; align-items:stretch; gap:5px; min-width:0; max-width:100%; }
+.review-before-version-wrap .review-before-version-strip { flex:1 1 auto; min-width:0; margin:0; }
+.review-version-scroll-btn { flex:0 0 26px; align-self:stretch; display:grid; place-items:center; padding:0; border:1px solid var(--border-default); border-radius:5px; background:var(--bg-surface-2); color:var(--text-secondary); cursor:pointer; }
+.review-version-scroll-btn:hover, .review-version-scroll-btn:focus-visible { border-color:var(--accent); color:var(--text-primary); background:var(--accent-selection); }
+.review-before-version { flex:0 0 auto; min-width:126px; max-width:220px; display:grid; gap:2px; padding:7px 9px; border:1px solid var(--border-subtle); border-radius:6px; background:var(--bg-surface-1); color:var(--text-secondary); text-align:left; cursor:pointer; }
+.review-before-version:hover { border-color:var(--border-strong); background:var(--bg-surface-3); }
+.review-before-version.is-selected { position:relative; border:2px solid var(--accent); background:color-mix(in srgb, var(--accent) 20%, var(--bg-surface-2)); color:var(--text-primary); box-shadow:0 0 0 2px var(--accent-selection), inset 3px 0 0 var(--accent); }
+.review-before-version.is-selected::after { content:'已选'; position:absolute; top:4px; right:4px; padding:1px 4px; border-radius:3px; background:var(--accent); color:#fff; font-size:8px; font-weight:700; }
+.review-before-version b { font:11px var(--font-mono); }
+.review-before-version span { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; font-size:10px; }
+.review-before-version time { color:var(--text-muted); font:8px var(--font-mono); white-space:nowrap; }
+.review-compare-toolbar { display:flex; align-items:center; justify-content:space-between; flex-wrap:wrap; gap:7px; }
+.review-compare-toolbar > span { margin:0; }
+@media (max-width:940px) { .review-workspace { height:auto; grid-template-columns:82px minmax(0,1fr); overflow:visible; } .review-shot-strip { height:420px; } .review-side { grid-column:1 / -1; height:auto; min-height:320px; } }
+@media (max-width:767px) { .review-workbench { height:auto; min-height:0; overflow:visible; } .review-workspace { grid-template-columns:minmax(0,1fr); min-height:0; height:auto; overflow:visible; } .review-shot-strip { height:128px; min-height:128px; } .review-shot-strip-scroll { flex-direction:row; overflow-x:auto; overflow-y:hidden; padding-bottom:2px; } .review-shot-group { flex:0 0 auto; min-width:220px; } .review-shot-group h4 { position:static; } .review-shot-chip { min-width:84px; } .review-shot-float-nav { display:none; } .review-side { grid-column:auto; height:auto; min-height:320px; } }
