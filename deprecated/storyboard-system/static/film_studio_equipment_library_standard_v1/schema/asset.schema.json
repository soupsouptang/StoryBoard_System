{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.frameforge/schema/film-equipment-asset.schema.json",
  "title": "Film Production Equipment Asset",
  "type": "object",
  "required": [
    "id",
    "name",
    "category",
    "asset_level",
    "source",
    "geometry",
    "coordinates",
    "anchors",
    "articulation",
    "compatibility",
    "verification"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9_\\-]+$"
    },
    "name": {
      "type": "string"
    },
    "manufacturer": {
      "type": [
        "string",
        "null"
      ]
    },
    "model": {
      "type": [
        "string",
        "null"
      ]
    },
    "category": {
      "enum": [
        "lighting",
        "modifier",
        "grip",
        "camera",
        "camera_support",
        "camera_movement",
        "sound",
        "video",
        "electrical",
        "stage",
        "studio"
      ]
    },
    "subcategory": {
      "type": [
        "string",
        "null"
      ]
    },
    "asset_level": {
      "enum": [
        "digital_twin",
        "engineering_replica",
        "generic_reference"
      ]
    },
    "source": {
      "type": "object",
      "required": [
        "primary_type",
        "primary_url",
        "license_review_required"
      ],
      "properties": {
        "primary_type": {
          "enum": [
            "official_cad",
            "official_drawing",
            "official_datasheet",
            "official_manual",
            "official_product_page",
            "third_party_model",
            "original_model"
          ]
        },
        "primary_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "secondary_urls": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "license_review_required": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "physical": {
      "type": "object",
      "properties": {
        "dimensions_m": {
          "type": [
            "array",
            "null"
          ],
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "weight_kg": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "power_w": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "minimum_height_m": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        },
        "maximum_height_m": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      }
    },
    "lighting": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "cct_k": {
          "type": [
            "array",
            "null"
          ],
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number"
          }
        },
        "beam_angle_deg": {
          "type": [
            "array",
            "null"
          ],
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "number"
          }
        },
        "native_beam_angle_deg": {
          "type": [
            "number",
            "null"
          ]
        },
        "photometric_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "gdtf_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "emitter_node": {
          "type": [
            "string",
            "null"
          ]
        },
        "light_axis_node": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "geometry": {
      "type": "object",
      "required": [
        "master_format",
        "lods",
        "materials_max"
      ],
      "properties": {
        "master_format": {
          "enum": [
            "STEP",
            "STP",
            "FBX",
            "BLEND",
            "OBJ",
            "GLB",
            "GLTF",
            "procedural"
          ]
        },
        "master_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "lods": {
          "type": "object",
          "required": [
            "lod0",
            "lod1",
            "lod2"
          ],
          "properties": {
            "lod0": {
              "$ref": "#/$defs/lod"
            },
            "lod1": {
              "$ref": "#/$defs/lod"
            },
            "lod2": {
              "$ref": "#/$defs/lod"
            }
          }
        },
        "materials_max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 24
        },
        "texture_max_px": {
          "type": "integer",
          "minimum": 64,
          "maximum": 4096
        },
        "brand_marks_in_runtime": {
          "type": "boolean"
        }
      }
    },
    "coordinates": {
      "type": "object",
      "required": [
        "unit",
        "up_axis",
        "forward_axis",
        "root_rule"
      ],
      "properties": {
        "unit": {
          "const": "meter"
        },
        "up_axis": {
          "const": "+Y"
        },
        "forward_axis": {
          "const": "+Z"
        },
        "root_rule": {
          "enum": [
            "floor_projection_center",
            "mount_center",
            "optical_center",
            "device_origin"
          ]
        },
        "ground_contact_required": {
          "type": "boolean"
        }
      }
    },
    "anchors": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "type"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "type": {
            "enum": [
              "stand_baby_16mm",
              "stand_junior_28mm",
              "bowens",
              "prolock_bowens",
              "arri_qlm",
              "quarter_20",
              "three_eighth_16",
              "15mm_lws",
              "19mm_studio",
              "grip_head",
              "frame_ear",
              "emitter",
              "light_axis",
              "optical_center",
              "image_plane",
              "accessory_front",
              "control_box",
              "cable_port",
              "custom"
            ]
          },
          "node": {
            "type": "string"
          },
          "position_m": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          },
          "rotation_deg": {
            "type": "array",
            "minItems": 3,
            "maxItems": 3,
            "items": {
              "type": "number"
            }
          }
        }
      }
    },
    "articulation": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "node",
          "kind"
        ],
        "properties": {
          "node": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "pan",
              "tilt",
              "extend",
              "rotate",
              "fold",
              "slide",
              "open_close"
            ]
          },
          "min": {
            "type": [
              "number",
              "null"
            ]
          },
          "max": {
            "type": [
              "number",
              "null"
            ]
          },
          "unit": {
            "enum": [
              "degree",
              "meter",
              "normalized"
            ]
          },
          "default": {
            "type": [
              "number",
              "null"
            ]
          }
        }
      }
    },
    "compatibility": {
      "type": "object",
      "properties": {
        "accepts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "provides": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "accessories": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "verification": {
      "type": "object",
      "required": [
        "dimensions",
        "pivot",
        "anchors",
        "articulation",
        "web_load",
        "thumbnail",
        "license"
      ],
      "properties": {
        "dimensions": {
          "enum": [
            "pass",
            "pending",
            "not_applicable"
          ]
        },
        "pivot": {
          "enum": [
            "pass",
            "pending",
            "not_applicable"
          ]
        },
        "anchors": {
          "enum": [
            "pass",
            "pending",
            "not_applicable"
          ]
        },
        "articulation": {
          "enum": [
            "pass",
            "pending",
            "not_applicable"
          ]
        },
        "web_load": {
          "enum": [
            "pass",
            "pending",
            "not_applicable"
          ]
        },
        "thumbnail": {
          "enum": [
            "pass",
            "pending",
            "not_applicable"
          ]
        },
        "license": {
          "enum": [
            "pass",
            "pending",
            "not_applicable"
          ]
        }
      }
    }
  },
  "$defs": {
    "lod": {
      "type": "object",
      "required": [
        "target_triangles",
        "path"
      ],
      "properties": {
        "target_triangles": {
          "type": "integer",
          "minimum": 100
        },
        "path": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}