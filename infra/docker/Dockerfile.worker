FROM python:3.12-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/apps/api

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl ffmpeg libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY apps/api/requirements-runtime.lock /app/requirements-runtime.lock
RUN pip install --no-cache-dir --require-hashes -r /app/requirements-runtime.lock

COPY apps/api /app/apps/api
COPY apps/worker /app/apps/worker
COPY packages /app/packages
# Licensed fonts used by generated documents.
COPY apps/web/public/fonts /app/apps/web/public/fonts

CMD ["python", "apps/worker/worker.py"]
