FROM python:3.12-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/app/apps/api

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*

COPY apps/api/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r /app/requirements.txt

COPY apps/api /app/apps/api
COPY packages /app/packages
# Pure shared parsers and licensed fonts only; no legacy server/database owner.
COPY storyboard-system/import_parsing.py storyboard-system/narration_timing.py storyboard-system/delivery_exports.py /app/storyboard-system/
COPY apps/web/public/fonts /app/apps/web/public/fonts

EXPOSE 8000

CMD ["python", "apps/api/main.py"]
