{
  "name": "@frameforge/ui",
  "version": "1.0.0",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./components/*": {
      "types": "./src/components/*.tsx",
      "default": "./dist/components/*.js"
    },
    "./lib/*": {
      "types": "./src/lib/*.ts",
      "default": "./dist/lib/*.js"
    },
    "./theme.css": "./src/theme.css"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run build && node tests/select.cjs && node tests/dialog-focus.cjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.48.0",
    "radix-ui": "1.6.7",
    "tailwind-merge": "^3.7.0"
  },
  "peerDependencies": {
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "typescript": "^5.7.3"
  }
}
